rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Doctor Appointments
    match /appointments/{appointmentId} {
      // Allow read if user is the booking owner, or if unauthenticated reading back created item
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == null);
      allow create: if true;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // AI Consultations Triage Records
    match /consultations/{consultationId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Hospital Bed Requests
    match /bedRequests/{bedRequestId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default connection test rule
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
